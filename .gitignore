# Environment and secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local databases / data dumps (never commit real store data)
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
data/
exports/
migration-extracts/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*~

# Infrastructure state (never commit — contains secrets and drift risk)
*.tfstate
*.tfstate.*
.terraform/
