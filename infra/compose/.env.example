# Copy to .env and fill in real values. .env is git-ignored — no secret is ever
# committed (hard rule #4). Replace every placeholder below before running anything.

POSTGRES_DB=sre_retail_os
POSTGRES_USER=sre_app
# Set a long random value. Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE

# The connection string the migration runner uses. Build it in your .env from the
# four values above, in this shape (no spaces):
#
#   the postgres scheme, then  ://  and POSTGRES_USER,
#   then  :  and POSTGRES_PASSWORD,
#   then  @db:5432/  and POSTGRES_DB
#
# Left blank here on purpose — set it in .env only, never in a committed file.
DATABASE_URL=

# Signs the catalogue packs every lane trades on. At least 32 characters — the API
# refuses to start on anything shorter, and refuses the placeholder below by name.
# Generate one with:  openssl rand -base64 48
PACK_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE

# Which environment the migration service may load into. Leave as 'rehearsal'.
# Setting this to 'production' is how a trial load reaches live data (hard rule #7).
MIGRATION_TARGET_KIND=rehearsal

# Host ports (change only if these clash with something already running).
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8081
