# Copy to .env and fill in real values. .env is git-ignored — no secret is ever
# committed (hard rule #4). Replace every placeholder below before running anything.

POSTGRES_DB=sre_retail_os
# The database ADMINISTRATOR (a superuser — the image makes it one). Administration only: backups by hand,
# emergencies. The API connects as the separate APPLICATION role below, which the database creates on first
# boot (infra/compose/db-init) with the SAME password — because a superuser bypasses the row-level security
# that keeps one tenant's rows from another (db/migrations/0012), and the API refuses to start on one.
POSTGRES_USER=sre_admin
# The application role's name (created on first boot; used in DATABASE_URL below). Leave as is.
APP_DB_USER=sre_app
# Set a long random value. This becomes part of DATABASE_URL below, so it MUST be URL-safe —
# generate one with:  openssl rand -hex 24   (hex has no '/' or '+', which would break the URL).
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE

# The connection string the migration runner uses. Build it in your .env from the
# four values above, in this shape (no spaces):
#
#   the postgres scheme, then  ://  and APP_DB_USER  (NOT the administrator — the API refuses a superuser),
#   then  :  and POSTGRES_PASSWORD,
#   then  @db:5432/  and POSTGRES_DB
#
# Because the password sits inside this URL, keep it URL-safe (the hex recipe above is); a
# '/' or '+' in it makes the whole string an invalid URL and nothing connects.
# Left blank here on purpose — set it in .env only, never in a committed file.
DATABASE_URL=

# Signs the catalogue packs every lane trades on. At least 32 characters — the API
# refuses to start on anything shorter, and refuses the placeholder below by name.
# Generate one with:  openssl rand -base64 48
PACK_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE

# ── Identity provider ────────────────────────────────────────────────────────
# The API VERIFIES tokens; it never issues one and never stores a credential
# (hard rule #4, M02-FR-01). These three say whose tokens to believe.
#
# All three are REQUIRED. Absent, `authenticate` would have to fall back to
# something, and every fallback here is a way in. A deployment with no identity
# provider configured does not start — which is louder than one that starts and
# lets everybody in.
#
# The shared secret your identity provider signs with (HS256). At least 32
# characters. Generate one with:  openssl rand -base64 48
IDP_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE
# What the token's `iss` claim must say. A correctly signed token from a
# different system is still not a token for here.
IDP_ISSUER=REPLACE_WITH_YOUR_IDENTITY_PROVIDER_URL
# What the token's `aud` claim must contain. One of ours is not all of ours.
IDP_AUDIENCE=sre-retail-os-api
# Optional: the longest any token may be valid for, in seconds (exp − iat). Default 31 days (2678400) — fits the
# store box's 30-day sync token. A token minted for longer is refused whatever the identity provider wrote.
# IDP_MAX_TOKEN_LIFETIME_SECONDS=2678400

# Which environment the migration service may load into. Leave as 'rehearsal'.
# Setting this to 'production' is how a trial load reaches live data (hard rule #7).
MIGRATION_TARGET_KIND=rehearsal

# ── The store edge ───────────────────────────────────────────────────────────
# Which shop this edge belongs to.
EDGE_TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID
# How much disk the edge may use for locally-committed work, in bytes.
# 10 GiB by default — enough for several days of trading with no line at all.
EDGE_CAPACITY_BYTES=10737418240
# OPTIONAL, and the reason the edge is offline-first: leave BOTH blank and the shop
# still sells, queues, and says plainly that nothing is being synced. Fill them in
# and it also drains to the cloud whenever there is a line.
CLOUD_API_URL=
CLOUD_API_TOKEN=

# Host ports (change only if these clash with something already running).
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8081
