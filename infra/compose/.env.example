# Copy to .env and fill in real values. .env is git-ignored — no secret is ever
# committed (hard rule #4). Replace every placeholder below before running anything.

POSTGRES_DB=sre_retail_os
# The database ADMINISTRATOR (a superuser — the image makes it one). Administration only: backups by hand,
# emergencies. The API connects as the separate APPLICATION role below, which the database creates on first
# boot (infra/compose/db-init) with the SAME password — because a superuser bypasses the row-level security
# that keeps one tenant's rows from another (db/migrations/0012), and the API refuses to start on one.
POSTGRES_USER=sre_admin
# The application role's name (created on first boot; used in DATABASE_URL below). Leave as is.
APP_DB_USER=sre_app
# Set a long random value. This becomes part of DATABASE_URL below, so it MUST be URL-safe —
# generate one with:  openssl rand -hex 24   (hex has no '/' or '+', which would break the URL).
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE

# The connection string the migration runner uses. Build it in your .env from the
# four values above, in this shape (no spaces):
#
#   the postgres scheme, then  ://  and APP_DB_USER  (NOT the administrator — the API refuses a superuser),
#   then  :  and POSTGRES_PASSWORD,
#   then  @db:5432/  and POSTGRES_DB
#
# Because the password sits inside this URL, keep it URL-safe (the hex recipe above is); a
# '/' or '+' in it makes the whole string an invalid URL and nothing connects.
# Left blank here on purpose — set it in .env only, never in a committed file.
DATABASE_URL=

# Signs the catalogue packs every lane trades on. At least 32 characters — the API
# refuses to start on anything shorter, and refuses the placeholder below by name.
# Generate one with:  openssl rand -base64 48
# Head office also derives, each under its own label and in memory only: the till seal and (unless
# PII_KEY_ENCRYPTION_KEY is set) the personal-data key. Every store computer holds this key too.
PACK_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE

# Head office's OWN secret for the seal on the store computers' saved history (owner decision
# OB-116). For the API ONLY — never copy it to a store computer or a till. At least 32 characters,
# and it must differ from PACK_SIGNING_KEY: the API refuses to start otherwise, and refuses the
# placeholder below by name. Generate with:  openssl rand -base64 48
# Changing it later sets the saved history aside once; it is rebuilt from the reports, nothing lost.
BOX_HISTORY_SEAL_KEY=REPLACE_WITH_A_GENERATED_VALUE

# ── Identity provider ────────────────────────────────────────────────────────
# The API VERIFIES tokens; it never issues one and never stores a credential
# (hard rule #4, M02-FR-01). These three say whose tokens to believe.
#
# All three are REQUIRED. Absent, `authenticate` would have to fall back to
# something, and every fallback here is a way in. A deployment with no identity
# provider configured does not start — which is louder than one that starts and
# lets everybody in.
#
# The shared secret your identity provider signs with (HS256). At least 32
# characters. Generate one with:  openssl rand -base64 48
IDP_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE
# What the token's `iss` claim must say. A correctly signed token from a
# different system is still not a token for here.
IDP_ISSUER=REPLACE_WITH_YOUR_IDENTITY_PROVIDER_URL
# What the token's `aud` claim must contain. One of ours is not all of ours.
IDP_AUDIENCE=sre-retail-os-api
# Optional: the longest any token may be valid for, in seconds (exp − iat). Default 31 days (2678400) — fits the
# store box's 30-day sync token. A token minted for longer is refused whatever the identity provider wrote.
# IDP_MAX_TOKEN_LIFETIME_SECONDS=2678400

# ── The self-hosted identity server (Keycloak, ADR-0019) — optional, off until set ──
# Start it with:  docker compose --profile identity up -d idp
# then route /auth/ to it:  SRE_AUTH_ROUTE=auth-upstream  SRE_AUTH_UPSTREAM=idp:8080
# Its database login (created on the database's FIRST boot only; on an existing database see the runbook):
# KEYCLOAK_DB_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE
# Its first administrator, used once to set it up (never shared; replaced after setup — runbook):
# KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE
# The address people reach it at, and the screens' own address (sign-in returns there):
# SRE_IDP_PUBLIC_URL=https://REPLACE_WITH_YOUR_ADDRESS/auth
# SRE_WEB_ORIGIN=https://REPLACE_WITH_YOUR_ADDRESS
# What the API checks its sign-ins against (inside the private network — the realm's own address is the issuer):
# IDP_OIDC_ISSUER=https://REPLACE_WITH_YOUR_ADDRESS/auth/realms/sre-store
# IDP_OIDC_JWKS_URL=http://idp:8080/auth/realms/sre-store/protocol/openid-connect/certs
# So the product's Admin screen can give people sign-ins: the secret the identity server GENERATED for its
# sre-provisioner client (admin console → Clients → sre-provisioner → Credentials), copied here — never made up:
# IDP_PROVISIONER_SECRET=REPLACE_WITH_THE_VALUE_FROM_THE_IDENTITY_SERVER
# The shop the first realm signs for (its tenant id), and — when a further shop has its own realm, made with
# `pnpm run realm:for-shop` and loaded at the identity server — that shop as realm=tenant, comma-separated:
# IDP_OIDC_TENANT_ID=REPLACE_WITH_THE_FIRST_SHOPS_TENANT_ID
# IDP_OIDC_SHOP_REALMS=sre-REPLACE_WITH_SHOP=REPLACE_WITH_ITS_TENANT_ID
# OB-510: each shop's CUSTOMER realm (sre-<shop>-customers, loaded beside its staff realm) and the one shop it signs for.
# Head office then believes a customer's token from it for that shop and for customers only. Leave unset until used:
# IDP_OIDC_CUSTOMER_REALMS=sre-store-customers=REPLACE_WITH_THE_FIRST_SHOPS_TENANT_ID

# Which environment the migration service may load into. Leave as 'rehearsal'.
# Setting this to 'production' is how a trial load reaches live data (hard rule #7).
MIGRATION_TARGET_KIND=rehearsal

# Where the shop's payment data is kept, and where off-site copies of it go (C12 · ADR-0002). India only: IN, or
# IN-<state> such as IN-MH or IN-TN. Any other value and the API refuses to start. Leave the backup line empty
# until off-site copies are set up.
PAYMENT_DATA_REGION=IN
# PAYMENT_BACKUP_REGION=IN

# ── The store edge ───────────────────────────────────────────────────────────
# Which shop this edge belongs to.
EDGE_TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID
# How much disk the edge may use for locally-committed work, in bytes.
# 10 GiB by default — enough for several days of trading with no line at all.
EDGE_CAPACITY_BYTES=10737418240
# OPTIONAL, and the reason the edge is offline-first: leave BOTH blank and the shop
# still sells, queues, and says plainly that nothing is being synced. Fill them in
# and it also drains to the cloud whenever there is a line.
CLOUD_API_URL=
CLOUD_API_TOKEN=

# Host ports (change only if these clash with something already running).
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8081

# ── The public front: ONE https origin (ADR-0018) ─────────────────────────────
# The address customers reach the shop at. A DOMAIN NAME (recommended) gets a free Let's Encrypt
# certificate automatically — then set SRE_TLS to the email address certificate notices should go to.
# Without a domain the proxy makes certificates itself: blank names only this machine (localhost, 127.0.0.1);
# for an IP-only demo add the box's public IP after them — `localhost, 127.0.0.1, <the box's IP>` (keep the
# first two: the pipeline's and the stand-up checks use them). Browsers warn once about a self-made
# certificate, which is fine for a synthetic demo and never acceptable for real customers.
SRE_PUBLIC_HOST=
SRE_TLS=internal
# The certificate served to a client that connects by bare IP (it sends no server name). Leave as localhost.
SRE_DEFAULT_SNI=localhost
# Customer sign-in on /auth/*: `auth-not-deployed` answers 503 by name until the sign-in service exists;
# `auth-upstream` forwards to SRE_AUTH_UPSTREAM once it does.
SRE_AUTH_ROUTE=auth-not-deployed
SRE_AUTH_UPSTREAM=auth:8082
# Customer sign-in by a code to the phone on /auth/otp/* (ADR-0031): `customer-sign-in-not-deployed` answers 503 by name;
# `customer-sign-in-upstream` forwards to the customer sign-in service (start it: docker compose --profile customer-sign-in
# up -d customer-sign-in, after `pnpm run build:customer-sign-in`). No SMS provider is connected (OB-222): it refuses to send.
SRE_CUSTOMER_SIGN_IN_ROUTE=customer-sign-in-not-deployed
# OB-510: the customer sign-in service's signer — the shop's customer realm at the identity server (runbook: customer
# sign-in). Leave unset: no signer. Its client credential is a FILE you create from the identity server's admin console,
# outside the repository (never paste the value here). Nothing is sent to any customer until an SMS provider is approved.
# CUSTOMER_SIGN_IN_SIGNER=keycloak
# CUSTOMER_REALM_ISSUER=https://REPLACE_WITH_THE_SHOPS_ADDRESS/auth/realms/sre-store-customers
# CUSTOMER_REALM_CLIENT_FILE=/srv/sre/secrets/customer-realm-client
# Staff screens on this address: `staff-not-public` answers them 404 by name — they live on the store box. Only the
# hosted DEMO's pilot overlay switches the demo sign-in gate on (`staff-demo-gate`, see .env.pilot.example).
SRE_STAFF_ROUTE=staff-not-public
# The public ports the proxy listens on (change only if something else already holds them).
HTTPS_PORT=443
HTTP_PORT=80
