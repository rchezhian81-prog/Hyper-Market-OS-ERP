# PILOT env template (non-production). Copy to .env.pilot and fill in generated
# values. .env.pilot is git-ignored (.gitignore covers .env.*) — no secret is ever
# committed (hard rule #4). Every REPLACE_WITH_… is refused by the service at boot.
#
# Use with: docker compose -p sre-pilot -f docker-compose.yml -f docker-compose.pilot.yml --env-file .env.pilot up -d

# ── Database (pilot only — separate from any real/prod database) ──────────────
POSTGRES_DB=sre_pilot
# The database ADMINISTRATOR (superuser) — administration only. The API connects as APP_DB_USER, a plain role the
# database creates on first boot (infra/compose/db-init) with the same password: a superuser bypasses the row-level
# security that keeps one tenant's rows from another (db/migrations/0012), and the API refuses to start on one.
POSTGRES_USER=sre_pilot_admin
APP_DB_USER=sre_pilot_app
# Generate URL-safe:  openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE
# Compose from the four values above, in the .env only (never in a committed file): the postgres
# scheme, then :// and APP_DB_USER (not the administrator), then : and POSTGRES_PASSWORD, then @db:5432/ and POSTGRES_DB.
# Keep the password URL-safe (the hex recipe above is). Left blank here on purpose.
DATABASE_URL=

# ── Signing keys (generate fresh for the pilot) ───────────────────────────────
# openssl rand -base64 48
PACK_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE

# ── Identity provider — PILOT uses the local/test IdP (production IdP deferred, OA-4) ──
# The API only VERIFIES tokens (hard rule #4). All three required or it will not start.
IDP_SIGNING_KEY=REPLACE_WITH_THE_TEST_IDP_KEY
IDP_ISSUER=REPLACE_WITH_YOUR_PILOT_TEST_IDP_URL
IDP_AUDIENCE=sre-retail-os-api

# ── Pilot posture (safe defaults — do not change for the pilot) ───────────────
NODE_ENV=production
# NEVER 'production' in the pilot — that is how a trial load reaches live data (hard rule #7).
MIGRATION_TARGET_KIND=rehearsal

# ── Genesis owner (the pilot's first admin; OA-6) ─────────────────────────────
EDGE_TENANT_ID=REPLACE_WITH_YOUR_PILOT_TENANT_ID
# BOOTSTRAP_OWNER_TENANT_ID / BOOTSTRAP_OWNER_USER_ID may be set to seed the first owner.

# ── Store edge ────────────────────────────────────────────────────────────────
EDGE_CAPACITY_BYTES=10737418240
# Leave the two below BLANK to start offline-first (sell + queue). Set them to also drain to the cloud.
CLOUD_API_URL=
CLOUD_API_TOKEN=

# ── Host ports (localhost-bound; put HTTPS/TLS termination in front) ──────────
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8081

# ── The public front: ONE https origin (ADR-0018) ─────────────────────────────
# The address customers reach the shop at. A DOMAIN NAME (recommended) gets a free Let's Encrypt
# certificate automatically — then set SRE_TLS to the email address certificate notices should go to.
# Without a domain the proxy makes certificates itself: blank names only this machine (localhost, 127.0.0.1);
# for an IP-only demo add the box's public IP after them — `localhost, 127.0.0.1, <the box's IP>` (keep the
# first two: the pipeline's and the stand-up checks use them). Browsers warn once about a self-made
# certificate, which is fine for a synthetic demo and never acceptable for real customers.
SRE_PUBLIC_HOST=
SRE_TLS=internal
# The certificate served to a client that connects by bare IP (it sends no server name). Leave as localhost.
SRE_DEFAULT_SNI=localhost
# Customer sign-in on /auth/*: `auth-not-deployed` answers 503 by name until the sign-in service exists;
# `auth-upstream` forwards to SRE_AUTH_UPSTREAM once it does.
SRE_AUTH_ROUTE=auth-not-deployed
SRE_AUTH_UPSTREAM=auth:8082
# Staff screens on the demo address (ADR-0016 behind ADR-0018): `staff-demo-gate` forwards them, the demo sign-in at
# /login/ and the demo store box (/store/) to the demo front, which lets them through only behind the demo sign-in;
# `staff-not-public` answers them 404 by name. The pilot overlay already defaults to the gate; this line makes it visible.
SRE_STAFF_ROUTE=staff-demo-gate
# The public ports the proxy listens on (change only if something else already holds them).
HTTPS_PORT=443
HTTP_PORT=80
