# PILOT env template (non-production). Copy to .env.pilot and fill in generated
# values. .env.pilot is git-ignored (.gitignore covers .env.*) — no secret is ever
# committed (hard rule #4). Every REPLACE_WITH_… is refused by the service at boot.
#
# Use with: docker compose -p sre-pilot -f docker-compose.yml -f docker-compose.pilot.yml --env-file .env.pilot up -d

# ── Database (pilot only — separate from any real/prod database) ──────────────
POSTGRES_DB=sre_pilot
POSTGRES_USER=sre_pilot_app
# Generate URL-safe:  openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_VALUE
# Compose from the four values above, in the .env only (never in a committed file): the postgres
# scheme, then :// and POSTGRES_USER, then : and POSTGRES_PASSWORD, then @db:5432/ and POSTGRES_DB.
# Keep the password URL-safe (the hex recipe above is). Left blank here on purpose.
DATABASE_URL=

# ── Signing keys (generate fresh for the pilot) ───────────────────────────────
# openssl rand -base64 48
PACK_SIGNING_KEY=REPLACE_WITH_A_GENERATED_VALUE

# ── Identity provider — PILOT uses the local/test IdP (production IdP deferred, OA-4) ──
# The API only VERIFIES tokens (hard rule #4). All three required or it will not start.
IDP_SIGNING_KEY=REPLACE_WITH_THE_TEST_IDP_KEY
IDP_ISSUER=REPLACE_WITH_YOUR_PILOT_TEST_IDP_URL
IDP_AUDIENCE=sre-retail-os-api

# ── Pilot posture (safe defaults — do not change for the pilot) ───────────────
NODE_ENV=production
# NEVER 'production' in the pilot — that is how a trial load reaches live data (hard rule #7).
MIGRATION_TARGET_KIND=rehearsal

# ── Genesis owner (the pilot's first admin; OA-6) ─────────────────────────────
EDGE_TENANT_ID=REPLACE_WITH_YOUR_PILOT_TENANT_ID
# BOOTSTRAP_OWNER_TENANT_ID / BOOTSTRAP_OWNER_USER_ID may be set to seed the first owner.

# ── Store edge ────────────────────────────────────────────────────────────────
EDGE_CAPACITY_BYTES=10737418240
# Leave the two below BLANK to start offline-first (sell + queue). Set them to also drain to the cloud.
CLOUD_API_URL=
CLOUD_API_TOKEN=

# ── Host ports (localhost-bound; put HTTPS/TLS termination in front) ──────────
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8081
