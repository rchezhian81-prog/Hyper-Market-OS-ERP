# infra/compose/Caddyfile — the ONE public origin (ADR-0018, Stage F slice 2).
#
# Everything a customer's browser needs is on one https address, so the customer app — relative by design —
# sends its short-lived token only to the host that served the page:
#   /v1/*, /livez, /readyz  → the cloud API          (the client address is OVERWRITTEN from the connection,
#                                                      so nobody can spoof the per-IP rate limit with a header)
#   /auth/*                 → customer sign-in        (503 by name until the sign-in service is deployed)
#   /customer/*             → the customer app        (served by the edge's screen server, private network only)
#   /                       → /customer/
#   staff screens, /login,  → 404 by name (SRE_STAFF_ROUTE=staff-not-public, the default): till, owner, manager, … stay on
#   /store, /store-lane       the store box. The hosted DEMO sets staff-demo-gate: forwarded to the demo front behind
#                             the demo sign-in (ADR-0016). See the two snippets below.
#   anything else           → 404 by name.
#
# TLS: SRE_PUBLIC_HOST names the address(es) the site answers to. A domain → a free certificate is fetched
# automatically (SRE_TLS = the email for certificate notices). Otherwise the proxy makes certificates itself
# (`internal`) for exactly the names listed — the default `localhost, 127.0.0.1`, plus the box's public IP when
# an IP-only demo adds it (`localhost, 127.0.0.1, <ip>`; keep the first two, the checks use them); browsers warn
# once — a synthetic demo, never real customers. (A bare `:443` would name nothing, and the internal issuer would
# have nothing to issue for — the handshake fails.) Plain http redirects to https. No secret lives here; every
# value arrives from the environment.

{
	admin off
	# A client that connects by bare IP sends no server name; inside a container Caddy then looks the
	# connection's LOCAL address up — the container's own IP, which has no certificate — and the handshake
	# fails. This names the certificate to serve such clients: `localhost` by default, always part of the
	# default site address below. (Proven by the front's first CI runs.)
	default_sni {$SRE_DEFAULT_SNI}
}

# Customer sign-in is not deployed yet: say so, by name, rather than 502 into nothing.
(auth-not-deployed) {
	handle /auth/* {
		header Content-Type application/json
		respond `{"error":{"code":"sign_in_not_deployed","whatHappened":"Customer sign-in is not deployed on this server yet.","wasItSaved":"not_saved","nextSafeAction":"Browse as a guest. Ordering needs sign-in, which arrives with the sign-in service."}}` 503
	}
}

# Customer sign-in is deployed at SRE_AUTH_UPSTREAM (Stage F slice 3): set SRE_AUTH_ROUTE=auth-upstream.
(auth-upstream) {
	# The identity server's ADMIN console is never on the public origin (ADR-0019): the administrator reaches it over an
	# SSH tunnel to the private network. Both the console and its API are refused here, by name.
	handle /auth/admin* {
		header Content-Type application/json
		respond `{"error":{"code":"not_public","whatHappened":"The identity server's administration is not reachable from the internet.","wasItSaved":"not_saved","nextSafeAction":"Administer it from the server itself (runbook: identity server)."}}` 404
	}
	handle /auth/* {
		reverse_proxy {$SRE_AUTH_UPSTREAM} {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Staff screens on the public origin — OFF by default (ADR-0018 §2: 404 by name until a sign-in gate exists). The hosted
# DEMO switches the gate on with SRE_STAFF_ROUTE=staff-demo-gate (ADR-0016, merged 3 Oct 2026): the staff shells, the
# demo sign-in (/login) and the demo store box's relay (/store, /store-lane) are forwarded to the DEMO FRONT — the `web`
# service running infra/compose/nginx.pilot.conf on the private compose network — which lets each request through only
# after the demo sign-in says yes (auth_request) and turns the demo session cookie into a bearer token for /v1. A /v1 call
# that carries that cookie and no Authorization header goes the same way for that one reason; every other /v1 call still
# goes straight to the API from here. The demo front never faces the public network: TLS, HSTS and the client address
# (overwritten from the connection, as below) remain this proxy's.
(staff-not-public) {
	@staff path /login /login/* /pos /pos/* /owner /owner/* /erp /erp/* /picker /picker/* /delivery /delivery/* /warehouse /warehouse/* /supplier /supplier/* /store /store/* /store-lane /store-lane/*
	handle @staff {
		header Content-Type application/json
		respond `{"error":{"code":"staff_screens_not_public","whatHappened":"Staff screens are not served on this address: SRE_STAFF_ROUTE is staff-not-public (the default). They live on the store box.","wasItSaved":"not_saved","nextSafeAction":"Open the screen on the store box. Only the hosted DEMO switches the demo sign-in gate on (SRE_STAFF_ROUTE=staff-demo-gate)."}}` 404
	}
}

(staff-demo-gate) {
	@staff path /login /login/* /pos /pos/* /owner /owner/* /erp /erp/* /picker /picker/* /delivery /delivery/* /warehouse /warehouse/* /supplier /supplier/* /store /store/* /store-lane /store-lane/*
	handle @staff {
		reverse_proxy web:80 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	@apiWithDemoCookie {
		path /v1/*
		header !Authorization
		header_regexp Cookie (^|;\s*)sre_demo_session=
	}
	handle @apiWithDemoCookie {
		reverse_proxy web:80 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

:80 {
	redir https://{host}{uri} permanent
}

{$SRE_PUBLIC_HOST} {
	tls {$SRE_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}
	# No referrer leaves this origin — except from the demo sign-in's own pages, whose service sets `same-origin` itself:
	# under `no-referrer` a browser posts the sign-in form with `Origin: null`, which the sign-in refuses as cross-site.
	# Deferred, like the block above, so it is the LAST word on every other response.
	@notSignIn not path /login /login/*
	header @notSignIn {
		Referrer-Policy no-referrer
		defer
	}

	# Staff screens: `staff-not-public` (default, 404 by name) or the hosted demo's `staff-demo-gate` — see the snippets.
	# Imported BEFORE the API route so that, with the gate on, a /v1 call carrying the demo session cookie is matched here first.
	import {$SRE_STAFF_ROUTE}

	@api path /v1/* /livez /readyz
	handle @api {
		reverse_proxy api:8081 {
			# The API keys its per-IP rate limit and sign-in lockout on the leftmost X-Forwarded-For entry.
			# Overwrite it from the connection so a caller's own header cannot stand in for their address.
			# (Caddy logs this line as "unnecessary" because, with no trusted proxies configured, it already
			# replaces the header for every client. It stays: the guarantee is then visible here and pinned.)
			header_up X-Forwarded-For {remote_host}
		}
	}

	import {$SRE_AUTH_ROUTE}

	@customer path /customer /customer/*
	handle @customer {
		reverse_proxy edge:8091
	}

	handle / {
		redir /customer/ 302
	}

	handle {
		header Content-Type application/json
		respond `{"error":{"code":"not_on_the_public_origin","whatHappened":"This address is not served on the public origin. Staff screens live on the store box and are not reachable from the internet.","wasItSaved":"not_saved","nextSafeAction":"Open the customer app at /customer/. Staff use the store box."}}` 404
	}
}
