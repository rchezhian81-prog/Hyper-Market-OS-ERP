# /opt/sre/deploy.conf — settings for infra/deploy/release.sh on THIS box. No secret belongs here: the
# secrets stay in infra/compose/.env.pilot (git-ignored), and this file only says which files to use.
# Every value below is the default; delete a line to keep the default. Copy to /opt/sre/deploy.conf.

# Where the application checkout lives (a git clone of the repository, owned by the deploy user).
SRE_APP_DIR=/opt/sre/app
# Only commits on this branch may deploy (a merged pull request with green checks lands here).
SRE_RELEASE_BRANCH=main
# The compose project name, files (relative to infra/compose) and env file — the demo runbook's values.
SRE_COMPOSE_PROJECT=sre-pilot
SRE_COMPOSE_FILES="docker-compose.yml docker-compose.pilot.yml"
SRE_ENV_FILE=.env.pilot
# Which app shells to rebuild on each release (folder names under apps/).
SRE_BUILD_SHELLS="pos owner-app web-erp picker-app delivery-app customer-app warehouse-app"
# Build-time flags. PILOT_DEMO_BANNER=1 bakes the "DEMO / PILOT — NOT PRODUCTION" banner into every shell;
# leave it EMPTY only on a box that holds real data under a written GO. PILOT_DEMO_LANE_BASE=/store-lane makes the
# hosted demo's till (served by the demo front) ring its sales on the DEMO store box through the signed-in front
# (ADR-0016); a store's build leaves it out, so its till keeps writing to its own box on loopback.
SRE_BUILD_ENV="PILOT_DEMO_BANNER=1 PILOT_DEMO_LANE_BASE=/store-lane"
# Tool bundles built from the checkout on every release: the DEMO-ONLY sign-in the pilot overlay runs. Harmless on
# a stack that never starts that service; set it EMPTY to skip.
SRE_BUILD_TOOLS="demo-login"
# Services that share another container's network namespace (the demo relay rides inside the edge's). Compose does not
# recreate them when that container is recreated, so the release does, every time. Empty on a stack without one.
SRE_RECREATE_SERVICES="edge-relay"
# Where the API answers on this box, how long to wait for READY, and how often to ask.
SRE_API_URL=http://127.0.0.1:8081
# The public front, checked after the stand-up check (which looks at loopback ports only, so a proxy that refuses to
# start would otherwise pass). Configuration B (the stack's proxy on a loopback port): https://127.0.0.1:8443. Empty skips it.
SRE_FRONT_URL=https://127.0.0.1
# The web front on the box's loopback (the base compose publishes it there). After a tool restart the release waits for
# it to answer again before the stand-up check; empty skips the wait.
SRE_WEB_URL=http://127.0.0.1:8080
SRE_READY_TIMEOUT=180
SRE_READY_POLL=2
# The append-only record of every deployment attempt, and the lock that keeps deployments one at a time.
SRE_RELEASE_LOG=/opt/sre/releases.log
SRE_DEPLOY_LOCK=/opt/sre/deploy.lock
# WF-20 (ADR-0026). The backup taken BEFORE a release changes anything: a command that exits 0 only when the backup
# succeeded (a failed one refuses the release, exit 69, nothing touched). Empty = none on this box (said on every run).
# The demo box's encrypted backup runs as its own service, e.g.:
#   SRE_PREDEPLOY_BACKUP_CMD="sudo /bin/systemctl start --wait sre-pilot-backup.service"
# (with a sudoers line allowing the deploy user exactly that command).
SRE_PREDEPLOY_BACKUP_CMD=
# The canary bake: on the CANARY box set e.g. 600 — the release must stay READY and add no more than SRE_BAKE_MAX_5XX
# server errors for that long, or it is rolled back and the pipeline's full rollout does not run. 0 = no bake.
SRE_BAKE_SECONDS=0
SRE_BAKE_POLL=15
SRE_BAKE_MAX_5XX=0
# QG-10 · WF-20: the books reconciled around every release (the ledger, the outbox, the sync backlog) — on by default.
# The snapshot runs inside the stack's own migrate container; nothing here is a secret. off = said on every run.
SRE_RECONCILE=on
# How far the sync backlog (pending outbox messages) may grow across a release before it counts as a difference.
SRE_RECONCILE_MAX_BACKLOG_GROWTH=0
# The append-only file of per-release QG-10 evidence lines (also printed for the pipeline's summary).
SRE_QG10_LOG=/opt/sre/qg10-evidence.jsonl
