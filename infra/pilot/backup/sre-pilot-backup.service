# Nightly ENCRYPTED demo backup (owner option C, 28 Sep 2026). Installed on the demo box only:
#   cp infra/pilot/backup/sre-pilot-backup.* /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now sre-pilot-backup.timer
[Unit]
Description=SRE demo pilot encrypted database backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# PA-12 r6: the job reports its own outcome under its own machine sign-in, provisioned by the operator into this
# root-only file (docs/runbooks/backup-and-recovery.md Part 3a). Missing, the job fails loudly and head office raises
# the backup as MISSED. Never in the repository.
EnvironmentFile=-/etc/sre-pilot/backup-reporter.env
ExecStart=/opt/sre/app/infra/pilot/backup/encrypted-backup.sh
TimeoutStartSec=600
NoNewPrivileges=true
