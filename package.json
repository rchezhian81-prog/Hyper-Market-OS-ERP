{
  "name": "sre-retail-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SRE Retail OS \u2014 a hybrid offline-first + cloud retail operating system for SRE Hyper Market. Built from the Final Master Roadmap & Developer Requirements v2.0.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "^3.3.17",
      "js-yaml@<4.3.2": "^4.3.2",
    "brace-expansion@<1.1.20": "^1.1.20",
    "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
    "source-map-js@<1.2.2": "^1.2.2"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "secret-scan": "node scripts/secret-scan.mjs",
    "completion": "node scripts/completion-report.mjs",
    "standup:check": "node scripts/standup-check.mjs",
    "till:install": "node scripts/install-till.mjs",
    "till:pin": "node edge/store-edge/dist/start.js till-pin",
    "token:store": "node scripts/issue-store-token.mjs",
    "seed:pilot": "node scripts/seed-pilot-hosted.mjs",
    "demo:publish-pack": "node scripts/demo-publish-pack.mjs",
    "demo:store-pack": "node scripts/demo-store-pack.mjs",
    "build:demo-login": "node scripts/build-service.mjs demo-login",
    "build:sign-in": "node scripts/build-service.mjs sign-in",
    "build:keycloak-theme": "node scripts/build-keycloak-theme.mjs",
    "demo-login:add": "node infra/pilot/demo-login/dist/demo-login.mjs add",
    "check:browser": "node scripts/pilot-browser-check.mjs",
    "drill:offline": "node scripts/pilot-offline-drill.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:pos": "node scripts/build-app.mjs pos",
    "build:owner": "node scripts/build-app.mjs owner-app",
    "build:erp": "node scripts/build-app.mjs web-erp",
    "build:picker": "node scripts/build-app.mjs picker-app",
    "build:delivery": "node scripts/build-app.mjs delivery-app",
    "build:customer": "node scripts/build-app.mjs customer-app",
    "build:warehouse": "node scripts/build-app.mjs warehouse-app",
    "ui:sync": "node scripts/sync-ui-foundation.mjs",
    "build:api": "node scripts/build-service.mjs api",
    "build:edge": "node scripts/build-service.mjs edge",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run secret-scan && pnpm run test && pnpm run test:perf && pnpm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true",
    "sbom": "node scripts/sbom.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "extract:check": "node --experimental-strip-types scripts/extract-check.mts",
    "tools:build": "node scripts/build-service.mjs tools",
    "migration:load": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/migration-load.js",
    "tenant:bootstrap": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/bootstrap-tenant.js",
    "realm:for-shop": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/realm-for-shop.js",
    "shop:new": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/new-shop.js",
    "shop:list": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/shops.js list",
    "shop:features": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/shops.js features",
    "demo:smoke": "node scripts/build-service.mjs tools >/dev/null && node scripts/dist/demo-smoke.js",
    "verify:audit": "node --experimental-strip-types scripts/verify-audit-chain.mts",
    "test:integration": "vitest run tests/integration",
    "test:migration": "vitest run tests/migration",
    "test:db": "vitest run tests/integration tests/migration",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.1",
    "@types/pg": "^8.20.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.10"
  }
}
